#Bullet cores & components
ie.manual.entry.bullet_cores.name=Geschosskern
ie.manual.entry.bullet_cores.subtext=Der ist abgeprallt!

ie.manual.entry.bullet_core.core_brass=Messingkern
ie.manual.entry.bullet_core.core_brass.lore=Mach es Steampunk
ie.manual.entry.bullet_core.core_brass.desc=Messing ist ein schweres Metall mit schlechten Durchschlagseigenschaften, aber es erhöht den Effekt anderer Komponenten erheblich.

ie.manual.entry.bullet_core.core_copper=Kupferkern
ie.manual.entry.bullet_core.core_copper.lore=Jeder Cent zählt
ie.manual.entry.bullet_core.core_copper.desc=Kupfer ist ein billiges Material für Geschosse, seine Durchschlagskraft ist schlechter als die von Messing, aber hat denselben Effekt auf andere Komponenten.

ie.manual.entry.bullet_core.core_lead=Bleikern
ie.manual.entry.bullet_core.core_lead.lore=Good, bad and ugly
ie.manual.entry.bullet_core.core_lead.desc=Blei ist ein gutes Material für Geschosse mit hohem Schaden und mittlerer Durchschlagskraft, jedoch limitiert die hohe Dichte die Reichweite der Geschosse.

ie.manual.entry.bullet_core.core_iron=Eisenkern
ie.manual.entry.bullet_core.core_iron.lore=Die Mittelklasse
ie.manual.entry.bullet_core.core_iron.desc=Eisen ist ein gutes Anfangsmaterial für Geschosse, es bietet überdurchschnittliche Reichweite und Durchschlagskraft, aber verschlechtert Komponenteneffekte und hat niedrigen Schaden.

ie.manual.entry.bullet_core.core_steel=Stahlkern
ie.manual.entry.bullet_core.core_steel.lore=Full Metal Jacket
ie.manual.entry.bullet_core.core_steel.desc=Stahl zu benutzen ist ein weniger teurer Weg die Durchschlagskraft eines Geschosses zu erhöhen, der einzige Nachteil ist der leicht verschlechterte Komponenteneffekt.

ie.manual.entry.bullet_core.core_tungsten=Wolframkern
ie.manual.entry.bullet_core.core_tungsten.lore=Ladet APCR!
ie.manual.entry.bullet_core.core_tungsten.desc=Waolfram hat bessere Durchschlagskraft als Stahl, aber es verschlechtert den Effekt anderer Komponenten mehr.

#Depleted in German has different Words for the context: ammo -> leer, uranium -> abgereichert
ie.manual.entry.bullet_core.core_uranium=Urankern
ie.manual.entry.bullet_core.core_uranium.lore=What do you mean, ammo is depleted?
ie.manual.entry.bullet_core.core_uranium.desc=Geringes Gewicht und Härte machen Uran großartig im Durchschlagen ohne die Fähigkeit zu verlieren, Sprengstoff zu tragen. Großartige aber teure Wahl.

ie.manual.entry.bullet_components.name=Geschoss Komponenten
ie.manual.entry.bullet_components.subtext=Lade APCRHEFSPTSD B-Capped!
ie.manual.entry.bullet_components.dmg_mod=Schaden: %sx
ie.manual.entry.bullet_components.pen_mod=Durchschlag: %s vBH
ie.manual.entry.bullet_components.blast_mod=Explosionsradius: %sx
ie.manual.entry.bullet_components.density=Dichte: %s
ie.manual.entry.bullet_components.type=Typ: %s

#A quote from World in Conflict
ie.manual.entry.bullet_component.firework=Feuerwerk
ie.manual.entry.bullet_component.firework.lore=Und jetzt, befreit die Himmel
ie.manual.entry.bullet_component.firework.desc=Feuerwerk, normalerweise für seine schönen Lichteffekte bekannt, kann zum unterdrücken und blenden von Feindern verwendet werden.

#Quote from Company of Heroes/Market Garden campaign
ie.manual.entry.bullet_component.tracer_powder=Leuchtspurpulver
ie.manual.entry.bullet_component.tracer_powder.lore=Füllt den Himmel mit Leuchtspuren!
ie.manual.entry.bullet_component.tracer_powder.desc=Leuchtspuren sind ein guter Weg die Flugbahn seiner Geschosse zu beobeachten, dies kann rein kosmetisch oder zum korrigieren des Schusswinkels verwendet werden.

#Reference to Codename Panzers: Cold War
ie.manual.entry.bullet_component.flare_powder=Leuchtsignalpulver
ie.manual.entry.bullet_component.flare_powder.lore=Macht die Nacht zum Tag
ie.manual.entry.bullet_component.flare_powder.desc=Leuchtsignale können als Lichquelle oder Markierung genutzt werden, was beim Ausrichten und Korrigieren von Artillerie hilfreich sein kann.

#Reference to the book "Thus Spoke Zarathustra"
ie.manual.entry.bullet_component.propaganda=Propaganda
ie.manual.entry.bullet_component.propaganda.lore=Wer gehorcht, kann sich nicht selbst befehlen!
ie.manual.entry.bullet_component.propaganda.desc=Propaganda kann verwendet werden um Angst in seinen Feinden zu streuen, das ist wenn er lesen kann, offensichtlich.

#Fallout reference
ie.manual.entry.bullet_component.nuke=Atombombe
ie.manual.entry.bullet_component.nuke.lore=War Never Changes
ie.manual.entry.bullet_component.nuke.desc=Nukleare Sprengstoffe sind stärksten und zerstörerischsten die dem Menschen bekannt sind, nur dicke Schichten aus verstärktem Beton können seiner Kraft standhalten. Zusätzlich schmilzt die Hitze der Detonation alle um sich herum und selbst dann werden die Überlebenden geschwind an der Radioaktiven Verseuchung sterben.

#Reference to a song
ie.manual.entry.bullet_component.tnt=TNT
ie.manual.entry.bullet_component.tnt.lore=Tons of it!
ie.manual.entry.bullet_component.tnt.desc=TNT ist eine explosives Material mit mittlerer Zerstörungskraft. Aufgrund seiner einfachen Herstellung ist es ein gutes Material für Maschinengewehrmunition und Granaten.

#CoH2 Reference
ie.manual.entry.bullet_component.rdx=RDX
ie.manual.entry.bullet_component.rdx.lore=Things go up, things go down!
ie.manual.entry.bullet_component.rdx.desc=RDX, auch als §sHexogen§r bekannt ist ein starkes hochexplosives Material. Mit der doppelten Stärke von TNT ist es ein leichtes Befestigungen zu zerstören.

#There are many variants of HMX's full name, one of them is Her Majesty's Explosive
ie.manual.entry.bullet_component.hmx=HMX
ie.manual.entry.bullet_component.hmx.lore=Her Majesty's Finest
ie.manual.entry.bullet_component.hmx.desc=HMX ist einer der stärksten konventionellen Sprengstoffe, seine Sprengkraft, welche dem dreifachen von TNT entspricht, lässt jede Befestigung erzittern.

#Reference to a song
ie.manual.entry.bullet_component.white_phosphorus=Weißer Phosphor
ie.manual.entry.bullet_component.white_phosphorus.lore=Storm clouds, fire and steel.
ie.manual.entry.bullet_component.white_phosphorus.desc=Wweißer Phosphor ist die Hauptzutat für Brandmunition. Seine hohe Hitze macht nahe Feinde brennbarer, während die brennend heißen Fragmente alles um sich entzünden.

#A reference to struggle between Tesla and Edison
#similar to how the Finns made a cocktail for Molotov (soviet foreign affairs minister) during the Winter War, a tesla grenade would be a nice one for Edison
ie.manual.entry.bullet_component.tesla=Entladungs Emitter
ie.manual.entry.bullet_component.tesla.lore=Ein Geschenk für Edison
ie.manual.entry.bullet_component.tesla.desc=Entladungs Emitter erschaffen ein Feld welcehs den elektischen Fluss stört. Sie sind nützlich um Industrielle Ausrüstung, Befestigungen und feindliche Energieerzeugung zu sabotieren.

## Shrapnels
ie.manual.entry.bullet_component.shrapnel_aluminum=Aluminium Schrapnell
ie.manual.entry.bullet_component.shrapnel_aluminum.lore=Aluminium, es lässt sich nicht einfach bemalen
ie.manual.entry.bullet_component.shrapnel_aluminum.desc=Aluminium ist nicht das beste Material für Schrapnell, aber ist günstig genug für den Masseneinsatz im Kampf.

ie.manual.entry.bullet_component.shrapnel_zinc=Zink Schrapnell
ie.manual.entry.bullet_component.shrapnel_zinc.lore=Besser als Zin!
ie.manual.entry.bullet_component.shrapnel_zinc.desc=Zink ist kein gutes Schrapnell Material, aber bei Materialknappheit erfüllt es den Zweck.

#Reference to Terraria's coin gun
ie.manual.entry.bullet_component.shrapnel_copper=Kupfer Schrapnell
ie.manual.entry.bullet_component.shrapnel_copper.lore=Mach Münzen deine Munition
ie.manual.entry.bullet_component.shrapnel_copper.desc=Obwohl Kupfer nach dem Feind zu werfen diesen nicht bestechen wird, könnte es ihn definitiv durchstechen.

#Reference to JoJo, yes even in the II there has to be one
ie.manual.entry.bullet_component.shrapnel_platinum=Platin Schrapnell
ie.manual.entry.bullet_component.shrapnel_platinum.lore=Ein Schrapnell Nutzer, huh?
ie.manual.entry.bullet_component.shrapnel_platinum.desc=Platin wählen? Ja, definitiv, mach dichselbst arm, du willst es, nicht ich.

#Murica' fuck yeah
ie.manual.entry.bullet_component.shrapnel_gold=Gold Schrapnell
ie.manual.entry.bullet_component.shrapnel_gold.lore=Und wen kümmern die Steuerzahler?
ie.manual.entry.bullet_component.shrapnel_gold.desc=Ah ja, der gute alte Weg Geld zu verschwenden - Krieg. Obwohl die Geschosse teuer sind, scheinen sie keine besondere Wirkung auf den Feind zu haben.

ie.manual.entry.bullet_component.shrapnel_nickel=Nickel Schrapnell
ie.manual.entry.bullet_component.shrapnel_nickel.lore=Nickels and dimes
ie.manual.entry.bullet_component.shrapnel_nickel.desc=Nickel ist eine schlechte Wahl für Schrapnell, es fügt wenig Schaden zu, aber in schweren Zeiten kann es den Tag retten.

#Reference to the Netflix's Witcher series
ie.manual.entry.bullet_component.shrapnel_silver=Silber Schrapnell
ie.manual.entry.bullet_component.shrapnel_silver.lore=Toss a coin to your gunner
ie.manual.entry.bullet_component.shrapnel_silver.desc=Silber Schrapnell ist eine gute Option um Untote zu bekämpfen, das Schrapnell fügt ihnen mehr Schaden zu und verlangsamt sie.

ie.manual.entry.bullet_component.shrapnel_electrum=Elektrum Schrapnell
ie.manual.entry.bullet_component.shrapnel_electrum.lore=Die Schocktruppen sind da
ie.manual.entry.bullet_component.shrapnel_electrum.desc=Elektrum ist überragend in der Stromübertragung, während das Schrapnell nicht viel Schaden zufügt werden getroffene Gegner mehr Schaden durch Energiewaffen nehmen, beispielsweise Teslaspulen.

#Reference to a post-ww2 poster for inter-country help in Western Europe
ie.manual.entry.bullet_component.shrapnel_constantan=Konstantan Schrapnell
ie.manual.entry.bullet_component.shrapnel_constantan.lore=<br>Whatever the weather, we kill enemies together.
ie.manual.entry.bullet_component.shrapnel_constantan.desc=Konstantan ist für seine Hitzeleitfähigkeit bekannt, getroffene Gegner werden für eine Zeit für Brandschden anfällig sein.

#Reference to words by Otto von Bismarck
ie.manual.entry.bullet_component.shrapnel_iron=Eisen Schrapnell
ie.manual.entry.bullet_component.shrapnel_iron.lore=Mit Blut und Eisen!
ie.manual.entry.bullet_component.shrapnel_iron.desc=Eisen ist eine gute Wahl dür Schrapnell, es durchdringt die leichten Rüstungen des Feindes mit Leichtigkeit.

ie.manual.entry.bullet_component.shrapnel_lead=Blei Schrapnell
ie.manual.entry.bullet_component.shrapnel_lead.lore=Lasst es Blei regnen!
ie.manual.entry.bullet_component.shrapnel_lead.desc=Blei ist ein gutes Schrapnell Material, es ist schwer und fügt ungepanzerten Feinden hohen Schaden zu.

#Japanese "hagane" means steel, but the literal translation is "full metal", Hagane no Renkinjutsushi
ie.manual.entry.bullet_component.shrapnel_steel=Stahl Schrapnell
ie.manual.entry.bullet_component.shrapnel_steel.lore=The fullmetal in all its glory
ie.manual.entry.bullet_component.shrapnel_steel.desc=Stahl ist ein gutes Schrapnell Material, guter Schaden, Verteilung und Geschwindigkeit machen es effektiv gegen jede Art von Feind.

ie.manual.entry.bullet_component.shrapnel_brass=Messing Schrapnell
ie.manual.entry.bullet_component.shrapnel_brass.lore=Ornamentales Design
ie.manual.entry.bullet_component.shrapnel_brass.desc=Messing ist eine schlechte Wahl für Schrapnell, obwohl es durch sein hohes Gewicht mehr Schaden zufügt als leichtere Metalle.

#A reference to Bear989sr. - a gregtech player, I just love when he says the word "steel", also some nice GT tutorials
ie.manual.entry.bullet_component.shrapnel_tungsten=Wolfram Schrapnell
ie.manual.entry.bullet_component.shrapnel_tungsten.lore=And now we make *ekhem* TUNGSTEN-STEEL...
ie.manual.entry.bullet_component.shrapnel_tungsten.desc=Wolfram ist ein sehr gutes Material für Schrapnell, seiner hoher Schaden reißt Gegner in Stücke.

#Reference to Kuruma saying IEn's thorium railgun rods are the strongest railgun ammo
ie.manual.entry.bullet_component.shrapnel_thorium=Thorium Schrapnell
ie.manual.entry.bullet_component.shrapnel_thorium.lore=Mach Granaten, nicht Stangen!
ie.manual.entry.bullet_component.shrapnel_thorium.desc=Thorium ist ein gutes aber teures Material für Schrapnell mit hohem Schaden und Durchschlagskraft.

ie.manual.entry.bullet_component.shrapnel_HOPGraphite=HOP Graphit Schrapnell
ie.manual.entry.bullet_component.shrapnel_HOPGraphite.lore=HOP to it!
ie.manual.entry.bullet_component.shrapnel_HOPGraphite.desc=Graphit ist ein sehr gutes Schrapnell Material, sein geringes Gewicht und hohe Durchschlagskraft machen es ideal für Gefechte.

ie.manual.entry.bullet_component.shrapnel_uranium=Uran Schrapnell
ie.manual.entry.bullet_component.shrapnel_uranium.lore=Ra-di-o-active
ie.manual.entry.bullet_component.shrapnel_uranium.desc=Uran ist eines der besten Materialien für Schrapnell, die einzelnen Fragmente haben kein Problem Panzerung zu durchschlagen und fügen hohen Schaden zu.

