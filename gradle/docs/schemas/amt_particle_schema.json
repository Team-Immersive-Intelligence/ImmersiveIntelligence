{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "offspring": {
      "type": "object",
      "properties": {
        "generator": {
          "type": "string",
          "enum": [
            "same",
            "rand_xz",
            "circle_xz",
            "cone_toward_25",
            "cone_toward_45",
            "cone_toward_75",
            "cone_toward_90",
            "sphere"
          ]
        },
        "type": {
          "type": "string"
        },
        "distance": {
          "type": "number",
          "description": "Distance from the parent particle to the generated POSITION."
        },
        "speed": {
          "type": "number",
          "description": "Generated motion speed. Defaults to distance when not set."
        },
        "stretch": {
          "type": "number",
          "default": 0,
          "description": "Distance from generated POSITION to the absolute STRETCH endpoint."
        },
        "amount": {
          "type": "integer",
          "minimum": 0
        },
        "min_amount": {
          "type": "integer",
          "minimum": 0
        },
        "max_amount": {
          "type": "integer",
          "minimum": 0
        },
        "inherited_properties": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "previous_position",
              "position",
              "motion",
              "rotation",
              "rotation_pitch",
              "rotation_yaw",
              "stretch",
              "scale",
              "size",
              "lifetime",
              "max_lifetime",
              "progress",
              "is_alive",
              "on_ground",
              "color",
              "color_secondary",
              "red",
              "green",
              "blue",
              "alpha",
              "textures",
              "textures_count",
              "texture_shift"
            ]
          }
        }
      },
      "required": ["generator", "distance", "type"],
      "oneOf": [
        {
          "required": ["amount"]
        },
        {
          "required": ["min_amount", "max_amount"]
        }
      ]
    }
  },
  "properties": {
    "type": {
      "type": "string",
      "description": "Particle class name",
      "enum": ["ParticleVanilla", "ParticleModel", "ParticleBasicGravity", "ParticleDebris"]
    },
    "models": {
      "type": "array",
      "description": "3D models used by this particle",
      "items": {
        "type": "string"
      }
    },
    "max_lifetime": {
      "description": "Maximum life time of this particle in ticks",
      "type": "integer"
    },
    "lifetime": {
      "description": "Starting life time of this particle in ticks",
      "type": "integer"
    },
    "draw_stage": {
      "description": "Draw stage of this particle, alters visual effects",
      "type": "string",
      "enum": [
        "vanilla", "vanilla_additive", "color_only_additive",
        "custom", "custom_additive", "custom_smoke_noise_shader",
        "custom_solid"
      ]
    },
    "programs": {
      "type": "array",
      "description": "Names of animation programs used by this particle, see IIParticles for details.",
      "items": {
        "type": "string"
      }
    },
    "aabb": {
      "description": "Radius of the bounding box of this particle",
      "type": "number"
    },
    "properties": {
      "description": "Additional properties of this particle",
      "type": "object"
    },
    "dynamic_properties": {
      "description": "Dynamically assigned properties of this particle",
      "type": "object"
    },
    "scheduled": {
      "description": "Particles scheduled to be spawned by this one after a time delay",
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/definitions/offspring"
          },
          {
            "type": "object",
            "properties": {
              "time": {
                "type": "integer"
              }
            },
            "required": ["time"]
          }
        ]
      }
    },
    "chained": {
      "type": "array",
      "description": "Particles spawned after death of this one",
      "items": {
        "$ref": "#/definitions/offspring"
      }
    }
  },
  "required": ["type", "max_lifetime", "draw_stage"]
}
